{
 "refusals": 1,
 "about": "Descriptors every reader must refuse, each for its reason. A case reads the descriptor file in base, applies each edit in turn (set a value, delete it, append to an array, or add a suffix to a string, at a path of field names and indices) or else replaces text in the file, recomputes the template hash unless reseal is false, and reads the result. With derive, the result must be read, and deriving those values must fail. A reader passes a case when it refuses it with an error that contains expect.",
 "cases": [
  {"name": "an unknown template field", "base": "templates/one_key_exit", "edit": [{"at": ["template", "expiry"], "set": 5}], "expect": "unknown field"},
  {"name": "an unknown field in a tree node", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "note"], "set": "x"}], "expect": "unknown field"},
  {"name": "an unknown field in a Simplicity leaf", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "branch", 0, "branch", 0, "simplicity", "note"], "set": "x"}], "expect": "unknown field"},
  {"name": "an unknown field in a path", "base": "templates/one_key_exit", "edit": [{"at": ["template", "paths", 0, "key"], "set": "x"}], "expect": "unknown field"},
  {"name": "an unknown field in a tapscript item", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "branch", 1, "tapscript", 0], "set": {"pick": "EXIT_DELAY"}}], "expect": "unknown field"},
  {"name": "an unknown field in the budget", "base": "templates/one_key_exit", "edit": [{"at": ["template", "budget", "min"], "set": 1}], "expect": "unknown field"},
  {"name": "a field named constructor", "base": "templates/one_key_exit", "edit": [{"at": ["template", "constructor"], "set": "x"}], "expect": "unknown field"},
  {"name": "a field named __proto__", "base": "templates/one_key_exit", "edit": [{"at": ["template", "__proto__"], "set": {"x": 1}}], "expect": "unknown field"},
  {"name": "a field named toString in a path", "base": "templates/one_key_exit", "edit": [{"at": ["template", "paths", 0, "toString"], "set": "x"}], "expect": "unknown field"},
  {"name": "a field named hasOwnProperty in a leaf", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "branch", 1, "hasOwnProperty"], "set": "x"}], "expect": "unknown field"},
  {"name": "a branch of three nodes", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "branch"], "append": {"leaf": "more", "data": ["PK"]}}], "expect": "two nodes"},
  {"name": "a branch of one node", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "branch", 1], "delete": true}], "expect": "two nodes"},
  {"name": "a leaf of two kinds", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "branch", 1, "data"], "set": ["PK"]}], "expect": "exactly one of"},
  {"name": "a leaf with no name", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "branch", 1, "leaf"], "delete": true}], "expect": "missing field"},
  {"name": "a missing budget field", "base": "templates/one_key_exit", "edit": [{"at": ["template", "budget", "max"], "delete": true}], "expect": "missing field"},
  {"name": "a missing slots field", "base": "templates/one_key_exit", "edit": [{"at": ["template", "slots"], "delete": true}], "expect": "missing field"},
  {"name": "a parameter in no leaf", "base": "templates/one_key_exit", "edit": [{"at": ["template", "params"], "append": {"name": "EXTRA", "type": "u64", "role": "amount", "label": "Extra"}}], "expect": "in no leaf"},
  {"name": "a spendable leaf no path describes", "base": "templates/one_key_exit", "edit": [{"at": ["template", "paths", 1], "delete": true}], "expect": "no path describes"},
  {"name": "a path that names a data leaf", "base": "templates/one_key_exit", "edit": [{"at": ["template", "paths", 1, "leaf"], "set": "params"}], "expect": "not a Simplicity or tapscript leaf"},
  {"name": "a path that names no leaf", "base": "templates/one_key_exit", "edit": [{"at": ["template", "paths", 1, "leaf"], "delete": true}], "expect": "names no leaf"},
  {"name": "a path named twice", "base": "templates/one_key_exit", "edit": [{"at": ["template", "paths", 1, "name"], "set": "spend"}], "expect": "used twice"},
  {"name": "two leaves of one name", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "branch", 1, "leaf"], "set": "spend"}], "expect": "named twice"},
  {"name": "a parameter named twice", "base": "templates/one_key_exit", "edit": [{"at": ["template", "params", 1, "name"], "set": "PK"}], "expect": "named twice"},
  {"name": "a one-byte push", "base": "templates/one_key_exit", "edit": [{"at": ["template", "params", 2], "set": {"name": "EXIT_DELAY", "type": "u8", "role": "number", "label": "Exit delay"}}, {"at": ["template", "tree", "branch", 1, "tapscript", 0], "set": {"push": "EXIT_DELAY"}}], "expect": "use num"},
  {"name": "a num wider than eight bytes", "base": "templates/one_key_exit", "edit": [{"at": ["template", "params", 2], "set": {"name": "EXIT_DELAY", "type": "u128", "role": "number", "label": "Exit delay"}}], "expect": "wider than 8 bytes"},
  {"name": "a slot in a tapscript", "base": "templates/one_key_exit", "edit": [{"at": ["template", "params", 2], "delete": true}, {"at": ["template", "slots"], "append": {"name": "EXIT_DELAY", "type": "u32", "role": "sequence", "label": "Exit delay"}}], "expect": "is a slot"},
  {"name": "a sequence that is not a u32", "base": "templates/one_key_exit", "edit": [{"at": ["template", "params", 2, "type"], "set": "u64"}], "expect": "a sequence is of type u32"},
  {"name": "a pubkey that is not a Pubkey", "base": "templates/one_key_exit", "edit": [{"at": ["template", "params", 1, "type"], "set": "u256"}], "expect": "a pubkey is of type Pubkey"},
  {"name": "a role the specification does not list", "base": "templates/one_key_exit", "edit": [{"at": ["template", "params", 1, "role"], "set": "owner"}], "expect": "is not allowed"},
  {"name": "a type the specification does not list", "base": "templates/one_key_exit", "edit": [{"at": ["template", "params", 1, "type"], "set": "u512"}], "expect": "is not allowed"},
  {"name": "a data leaf naming nothing known", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "branch", 0, "branch", 1, "data"], "set": ["NOPE"]}], "expect": "no parameter or slot"},
  {"name": "an empty data leaf", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "branch", 0, "branch", 1, "data"], "set": []}], "expect": "commits to nothing"},
  {"name": "a witness naming no parameter", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "branch", 0, "branch", 0, "simplicity", "witness", 0, "source"], "set": "param:NOPE"}], "expect": "is no parameter"},
  {"name": "a witness of another type than its parameter", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "branch", 0, "branch", 0, "simplicity", "witness", 0, "type"], "set": "u256"}], "expect": "is not the parameter's"},
  {"name": "a witness source the specification does not list", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "branch", 0, "branch", 0, "simplicity", "witness", 1, "source"], "set": "signature:other:PK"}], "expect": "not one the specification lists"},
  {"name": "a signature by a key that is not a Pubkey", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "branch", 0, "branch", 0, "simplicity", "witness", 1, "source"], "set": "signature:sig_all_hash:EXIT_DELAY"}], "expect": "by a Pubkey parameter"},
  {"name": "a witness named twice", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "branch", 0, "branch", 0, "simplicity", "witness", 1, "name"], "set": "PK"}], "expect": "named twice"},
  {"name": "a source outside the descriptor's directory", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "branch", 0, "branch", 0, "simplicity", "source"], "set": "../one_key/one_key.simf"}], "expect": ".simf beside the descriptor"},
  {"name": "a source that is not a .simf file", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "branch", 0, "branch", 0, "simplicity", "source"], "set": "one_key_exit.txt"}], "expect": ".simf beside the descriptor"},
  {"name": "a template that is not printable ASCII", "base": "templates/one_key_exit", "edit": [{"at": ["template", "summary"], "set": "one\u2028line"}], "expect": "printable ASCII"},
  {"name": "a tab in a template", "base": "templates/one_key_exit", "edit": [{"at": ["template", "paths", 0, "who"], "set": "the\tholder"}], "expect": "printable ASCII"},
  {"name": "a cmr one byte too long", "base": "templates/one_key_exit", "edit": [{"at": ["template", "tree", "branch", 0, "branch", 0, "simplicity", "cmr"], "suffix": "00"}], "expect": "bytes where"},
