    "paths": [
      {
        "effect": "Pays output 1, in ASSET, to any script but this one, at most TIER1_MAX while the reserve holds at least TIER1_FLOOR, else TIER2_MAX from TIER2_FLOOR, else TIER3_MAX from TIER3_FLOOR, else TIER4_MAX; once INTERVAL units of 512 seconds have passed since the reserve confirmed; with fees of at most FEE_CAP in ASSET; and pays the rest to output 0 at this script, which waits the interval again. The reserve must be input 0.",
        "leaf": "drip",
        "name": "drip",
        "who": "the holder of FAUCET_KEY"
      },
      {
        "effect": "Spends the whole reserve into any transaction TREASURY_KEY signs, once the reserve has gone RECOVERY_DELAY, a BIP68 relative lock, without a drip. Each drip starts the delay again, so while drips continue the reserve cannot be recovered.",
        "leaf": "recover",
        "name": "recover",
        "who": "the holder of TREASURY_KEY"
      }
    ],
    "slots": [],
    "summary": "A faucet reserve that pays out at most one tier per interval to whatever the faucet key signs for, and that the treasury key recovers once drips stop.",
